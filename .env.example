MONGODB_URI=mongodb://127.0.0.1:27017/hybrid-networks
JWT_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3004

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hybrid Networks <billing@hybridnetworks.com>"

# Despite the name, this holds the SLASH API key (sk_...), not a URL — sent
# as the X-API-Key header to https://slash-api.rudra.sh/api/v1. See lib/starlink/.
API_URL=
# Optional override of the SLASH API base URL (defaults to slash-api.rudra.sh).
STARLINK_API_BASE_URL=
