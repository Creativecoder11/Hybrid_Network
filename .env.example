MONGODB_URI=mongodb://127.0.0.1:27017/hybrid-networks
JWT_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3004

# --- Subdomain-split production deployment only (see docs/deployment.md) ---
# Leave all three blank for local dev and for a single-domain deployment —
# the app behaves exactly as before (path-based /admin + /portal, one origin).
#
# Set on the ADMIN deployment only:
#   PORTAL_MODE=admin
# Set on the CUSTOMER deployment only:
#   PORTAL_MODE=customer
PORTAL_MODE=
# Full origin (with https://) of each subdomain — needed by whichever
# deployment does NOT own that portal, so it can bounce mismatched requests
# to the right place instead of 404ing.
ADMIN_PORTAL_URL=
CUSTOMER_PORTAL_URL=
# Node.js host panels (Hostinger hPanel, cPanel Node.js Selector, etc.)
# assign this themselves — don't set it manually on those hosts.
PORT=3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hybrid Networks <billing@hybridnetworks.com>"

# SLASH API (Starlink Enterprise data) — see lib/starlink/.
# Sent as the X-API-Key header to SLASH_API_BASE_URL.
SLASH_API_KEY=
# Optional override (defaults to https://slash-api.rudra.sh/api/v1).
SLASH_API_BASE_URL=
# Legacy names, still read as a fallback if the above are unset — keeps
# existing deployments working without a redeploy. Despite its name, API_URL
# holds the SLASH API key (sk_...), not a URL. Prefer SLASH_API_KEY /
# SLASH_API_BASE_URL above for anything new.
# Google Maps JavaScript API key for terminal GPS tracking & fleet maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
